# ============================================================================
# RadA-BenchPlat credentials
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in only the providers you plan to run.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real keys. The agent core reads them
# through Utils/llm_client.py and no key is written into source.
# ============================================================================

# --- providers used by the models in Configs/models.yaml --------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
LLAMA_API_KEY=

# --- optional endpoint overrides --------------------------------------------
# Set these only when routing through a gateway or a self-hosted deployment.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GOOGLE_BASE_URL=
# DEEPSEEK_BASE_URL=
# DASHSCOPE_BASE_URL=
# LLAMA_BASE_URL=

# --- local checkpoints for the `local_hf` backend ---------------------------
# MIXTRAL_PATH=/path/to/Mixtral-8x7B-Instruct-v0.1
# QWEN_PATH=/path/to/Qwen2.5-72B-Instruct
